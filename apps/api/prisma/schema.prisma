generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  BACKLOG
  PLANNED
  IN_PROGRESS
  SHIPPED
}

enum Language {
  en
  he
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  widgetKey String   @unique @default(cuid())
  createdAt DateTime @default(now())

  requireSignedIdentity           Boolean   @default(false)
  identitySecret                  String?
  previousIdentitySecret          String?
  previousIdentitySecretExpiresAt DateTime?
  signedIdentityConnectedAt       DateTime?

  members         WorkspaceMember[]
  contacts        Contact[]
  featureRequests FeatureRequest[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  @@unique([workspaceId, agentId])
}

model Agent {
  id           String   @id @default(cuid()) 
  name         String
  email        String   @unique
  passwordHash String
  language     Language?
  createdAt    DateTime @default(now())

  memberships   WorkspaceMember[]
  refreshTokens RefreshToken[]
}

model Contact {
  id              String    @id @default(cuid())
  externalId      String
  name            String?
  email           String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  requests FeatureRequest[]
  votes    Vote[]

  @@unique([workspaceId, externalId])
}

model FeatureRequest {
  id          String        @id @default(cuid())
  title       String
  description String
  status      RequestStatus @default(BACKLOG)
  createdAt   DateTime      @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  authorId       String?
  author         Contact? @relation(fields: [authorId], references: [id])
  authorVerified Boolean  @default(false)

  votes Vote[]

  @@index([workspaceId, status])
}

model Vote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id])

  requestId String
  request   FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([contactId, requestId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([agentId])
}
